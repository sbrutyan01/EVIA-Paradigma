// ===================== EVIA Paradigma native runtime: Linux x86-64, system calls only =====================
// Strings are objects [length: 8 bytes][UTF-8 bytes]. Memory comes from mmap and is never given back.

const SYS_READ = 0;
const SYS_WRITE = 1;
const SYS_MMAP = 9;
const SYS_NANOSLEEP = 35;
const SYS_EXIT = 60;
const SYS_CLOCK_GETTIME = 228;

// ---------------------------------------------------------------- memory

var heap_ptr: int;
var heap_end: int;

fn alloc(n): int {
    n = (n + 15) & ~15;
    if (heap_ptr + n > heap_end) {
        var size = 1 << 24;
        if (n > size) { size = n; }
        var p = syscall(SYS_MMAP, 0, size, 3, 0x22, -1, 0);     // read+write, private+anonymous
        if (p < 0 && p > -4096) { raw_fail("out of memory"); }
        heap_ptr = p;
        heap_end = p + size;
    }
    var r = heap_ptr;
    heap_ptr = heap_ptr + n;
    return r;
}

fn copy(dst, src, n) {
    var i = 0;
    while (i + 8 <= n) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    while (i < n) {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
}

// ---------------------------------------------------------------- output (buffered), errors

buffer out_buf[65536];
var out_len: int;

fn write_all(fd, p, n) {
    while (n > 0) {
        var w = syscall(SYS_WRITE, fd, p, n);
        if (w <= 0) { return; }
        p = p + w;
        n = n - w;
    }
}

fn out_flush() {
    write_all(1, out_buf, out_len);
    out_len = 0;
}

fn out_bytes(p, n) {
    if (out_len + n > 65536) { out_flush(); }
    if (n > 65536) {
        write_all(1, p, n);
        return;
    }
    copy(out_buf + out_len, p, n);
    out_len = out_len + n;
}

fn out_byte(c) {
    if (out_len >= 65536) { out_flush(); }
    store8(out_buf + out_len, c);
    out_len = out_len + 1;
}

fn out_str(s) {
    out_bytes(s + 8, load64(s));
}

fn out_line(s) {
    out_str(s);
    out_byte('\n');
}

fn exit_program(code) {
    out_flush();
    syscall(SYS_EXIT, code);
}

/** The interpreter's error: the output so far, then ">> error: message" on stderr, and exit code 1. */
var err_prefix: int;

fn fail(msg) {
    out_flush();
    var head = ">> error: ";
    write_all(2, head + 8, load64(head));
    if (err_prefix != 0) { write_all(2, err_prefix + 8, load64(err_prefix)); }
    write_all(2, msg + 8, load64(msg));
    write_all(2, "\n" + 8, 1);
    syscall(SYS_EXIT, 1);
}

fn raw_fail(text) {
    fail(text);
}

// ---------------------------------------------------------------- strings

fn str_new(n): int {
    var s = alloc(8 + n);
    store64(s, n);
    return s;
}

fn str_concat(a, b): int {
    var la = load64(a);
    var lb = load64(b);
    var s = str_new(la + lb);
    copy(s + 8, a + 8, la);
    copy(s + 8 + la, b + 8, lb);
    return s;
}

fn str3(a, b, c): int {
    return str_concat(str_concat(a, b), c);
}

fn str_eq(a, b): int {
    var n = load64(a);
    if (n != load64(b)) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(a + 8 + i) != load8(b + 8 + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

/** Byte order of the UTF-8 text: the order of the characters. */
fn str_cmp(a, b): int {
    var la = load64(a);
    var lb = load64(b);
    var i = 0;
    while (i < la && i < lb) {
        var x = load8(a + 8 + i);
        var y = load8(b + 8 + i);
        if (x != y) { return x - y; }
        i = i + 1;
    }
    return la - lb;
}

/** A whole number as text: -12, 0, 999999999999999. */
buffer itb[32];

fn int_text(v): int {
    var neg = v < 0;
    if (neg) { v = -v; }
    var i = 32;
    while (1) {
        i = i - 1;
        store8(itb + i, '0' + v % 10);
        v = v / 10;
        if (v == 0) { break; }
    }
    if (neg) {
        i = i - 1;
        store8(itb + i, '-');
    }
    var s = str_new(32 - i);
    copy(s + 8, itb + i, 32 - i);
    return s;
}

// ---------------------------------------------------------------- input

buffer in_buf[65536];
var in_pos: int;
var in_len: int;
var in_eof: int;

/** The next byte of stdin, or -1 at its end. */
fn in_byte(): int {
    if (in_pos >= in_len) {
        if (in_eof) { return -1; }
        var n = syscall(SYS_READ, 0, in_buf, 65536);
        if (n <= 0) {
            in_eof = 1;
            return -1;
        }
        in_pos = 0;
        in_len = n;
    }
    var c = load8(in_buf + in_pos);
    in_pos = in_pos + 1;
    return c;
}

/** "Enter a value for NAME: ", then a line without its "\n" (and "\r"); "input cancelled" at the end of stdin. */
fn read_line(name): int {
    out_str("Enter a value for ");
    out_str(name);
    out_str(": ");
    out_flush();
    var c = in_byte();
    if (c < 0) { fail("input cancelled"); }
    var cap = 64;
    var s = str_new(cap);
    var n = 0;
    while (c >= 0 && c != '\n') {
        if (n == cap) {
            var t = str_new(cap * 2);
            copy(t + 8, s + 8, n);
            s = t;
            cap = cap * 2;
        }
        store8(s + 8 + n, c);
        n = n + 1;
        c = in_byte();
    }
    if (n > 0 && load8(s + 8 + n - 1) == '\r') { n = n - 1; }
    store64(s, n);
    return s;
}

// ---------------------------------------------------------------- method calls and time

var depth: int;

fn enter() {
    if (depth >= 400) { fail("too many nested method calls (endless recursion?)"); }
    depth = depth + 1;
}

fn leave() {
    depth = depth - 1;
}

buffer ts[16];
var start_ms: int;

fn now_ms(): int {
    syscall(SYS_CLOCK_GETTIME, 1, ts);      // CLOCK_MONOTONIC
    return load64(ts) * 1000 + load64(ts + 8) / 1000000;
}

fn millis(): float {
    return i2f(now_ms() - start_ms);
}

fn delay(ms: float) {
    if (!(ms > 0.0)) { return; }
    out_flush();
    var whole = f2i(ms);
    store64(ts, whole / 1000);
    store64(ts + 8, (whole % 1000) * 1000000);
    syscall(SYS_NANOSLEEP, ts, 0);
}

fn runtime_init() {
    start_ms = now_ms();
}

// ================================================================ big whole numbers (32-bit limbs in 64-bit words)
// For printing and reading numbers exactly. They live in a scratch area that every conversion starts afresh.

const LIMBS = 400;
buffer scratch[1048576];
var scratch_ptr: int;

fn big_new(): int {
    var b = scratch + scratch_ptr;
    scratch_ptr = scratch_ptr + 8 * (LIMBS + 1);
    store64(b, 0);
    return b;
}

fn big_n(b): int { return load64(b); }
fn big_limb(b, i): int { return load64(b + 8 + 8 * i); }
fn big_put(b, i, v) { store64(b + 8 + 8 * i, v); }

fn big_trim(b) {
    var n = load64(b);
    while (n > 0 && big_limb(b, n - 1) == 0) { n = n - 1; }
    store64(b, n);
}

fn big_set(b, v) {
    store64(b, 0);
    var i = 0;
    while (v != 0) {
        big_put(b, i, v & 0xFFFFFFFF);
        v = v >>> 32;
        i = i + 1;
    }
    store64(b, i);
}

fn big_copy(dst, src) {
    copy(dst, src, 8 * (load64(src) + 1));
}

fn big_mul_small(b, m) {
    var n = load64(b);
    var carry = 0;
    var i = 0;
    while (i < n) {
        var x = big_limb(b, i) * m + carry;
        big_put(b, i, x & 0xFFFFFFFF);
        carry = x >>> 32;
        i = i + 1;
    }
    if (carry != 0) {
        big_put(b, n, carry);
        store64(b, n + 1);
    }
}

fn big_add_small(b, v) {
    var n = load64(b);
    var i = 0;
    var carry = v;
    while (carry != 0) {
        var x = carry;
        if (i < n) { x = x + big_limb(b, i); }
        big_put(b, i, x & 0xFFFFFFFF);
        carry = x >>> 32;
        i = i + 1;
        if (i > n) { n = i; }
    }
    store64(b, n);
}

/** dst = dst + a */
fn big_add(dst, a) {
    var n = load64(dst);
    var m = load64(a);
    var top = n;
    if (m > top) { top = m; }
    var carry = 0;
    var i = 0;
    while (i < top) {
        var x = carry;
        if (i < n) { x = x + big_limb(dst, i); }
        if (i < m) { x = x + big_limb(a, i); }
        big_put(dst, i, x & 0xFFFFFFFF);
        carry = x >>> 32;
        i = i + 1;
    }
    if (carry != 0) {
        big_put(dst, top, carry);
        top = top + 1;
    }
    store64(dst, top);
}

/** dst = dst - a, when dst >= a */
fn big_sub(dst, a) {
    var n = load64(dst);
    var m = load64(a);
    var borrow = 0;
    var i = 0;
    while (i < n) {
        var x = big_limb(dst, i) - borrow;
        if (i < m) { x = x - big_limb(a, i); }
        if (x < 0) {
            x = x + 0x100000000;
            borrow = 1;
        } else {
            borrow = 0;
        }
        big_put(dst, i, x);
        i = i + 1;
    }
    big_trim(dst);
}

fn big_cmp(a, b): int {
    var n = load64(a);
    var m = load64(b);
    if (n != m) {
        if (n > m) { return 1; }
        return -1;
    }
    var i = n - 1;
    while (i >= 0) {
        var x = big_limb(a, i);
        var y = big_limb(b, i);
        if (x != y) {
            if (x > y) { return 1; }
            return -1;
        }
        i = i - 1;
    }
    return 0;
}

/** b = b * 2^k */
fn big_shl(b, k) {
    if (load64(b) == 0) { return; }
    var words = k / 32;
    var bitsn = k % 32;
    var n = load64(b);
    if (words > 0) {
        var i = n - 1;
        while (i >= 0) {
            big_put(b, i + words, big_limb(b, i));
            i = i - 1;
        }
        i = 0;
        while (i < words) {
            big_put(b, i, 0);
            i = i + 1;
        }
        n = n + words;
        store64(b, n);
    }
    if (bitsn > 0) {
        var carry = 0;
        var j = 0;
        while (j < n) {
            var x = (big_limb(b, j) << bitsn) | carry;
            big_put(b, j, x & 0xFFFFFFFF);
            carry = x >>> 32;
            j = j + 1;
        }
        if (carry != 0) {
            big_put(b, n, carry);
            store64(b, n + 1);
        }
    }
}

fn big_mul_pow10(b, k) {
    while (k >= 9) {
        big_mul_small(b, 1000000000);
        k = k - 9;
    }
    while (k > 0) {
        big_mul_small(b, 10);
        k = k - 1;
    }
}

// ================================================================ numbers as text, exactly as Java writes them

buffer digits[1200];
var ndigits: int;
var dexp: int;          // the value is 0.d1d2d3... * 10^dexp

/**
 * The shortest digits that read back as x (x > 0, finite), the nearest of them when there is a choice:
 * Steele and White's free-format algorithm with Burger and Dybvig's scaling, in exact whole numbers.
 */
fn shortest(x: float) {
    scratch_ptr = 0;
    var b = bits(x);
    var be = (b >>> 52) & 0x7FF;
    var f = b & 0xFFFFFFFFFFFFF;
    var e = -1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    var even = (f & 1) == 0;
    var r = big_new();
    var s = big_new();
    var mp = big_new();
    var mm = big_new();
    if (e >= 0) {
        if (f != 0x10000000000000) {
            big_set(r, f); big_shl(r, e + 1);
            big_set(s, 2);
            big_set(mp, 1); big_shl(mp, e);
            big_set(mm, 1); big_shl(mm, e);
        } else {
            big_set(r, f); big_shl(r, e + 2);
            big_set(s, 4);
            big_set(mp, 1); big_shl(mp, e + 1);
            big_set(mm, 1); big_shl(mm, e);
        }
    } else {
        if (be <= 1 || f != 0x10000000000000) {
            big_set(r, f); big_shl(r, 1);
            big_set(s, 1); big_shl(s, 1 - e);
            big_set(mp, 1);
            big_set(mm, 1);
        } else {
            big_set(r, f); big_shl(r, 2);
            big_set(s, 1); big_shl(s, 2 - e);
            big_set(mp, 2);
            big_set(mm, 1);
        }
    }
    // k: an estimate of ceil(log10 x) from the top bit, never too large
    var top = 0;
    var t = f;
    while (t != 0) {
        top = top + 1;
        t = t >>> 1;
    }
    var k = f2i(ceil_f(i2f(e + top - 1) * 0.30102999566398114 - 0.0000000001));
    if (k >= 0) {
        big_mul_pow10(s, k);
    } else {
        big_mul_pow10(r, -k);
        big_mul_pow10(mp, -k);
        big_mul_pow10(mm, -k);
    }
    // too small by one when the upper end of the interval reaches 10^k
    var hi = big_new();
    big_copy(hi, r);
    big_add(hi, mp);
    var c = big_cmp(hi, s);
    if (c > 0 || (even && c == 0)) {
        k = k + 1;
        big_mul_small(s, 10);
    }
    ndigits = 0;
    dexp = k;
    while (1) {
        big_mul_small(r, 10);
        big_mul_small(mp, 10);
        big_mul_small(mm, 10);
        var d = 0;
        while (big_cmp(r, s) >= 0) {
            big_sub(r, s);
            d = d + 1;
        }
        var lo = big_cmp(r, mm);
        var tc1 = lo < 0 || (even && lo == 0);
        big_copy(hi, r);
        big_add(hi, mp);
        var up = big_cmp(hi, s);
        var tc2 = up > 0 || (even && up == 0);
        if (!tc1 && !tc2) {
            store8(digits + ndigits, d);
            ndigits = ndigits + 1;
            continue;
        }
        if (tc1 && tc2) {
            big_copy(hi, r);
            big_shl(hi, 1);
            var h = big_cmp(hi, s);
            if (h > 0 || (h == 0 && (d & 1) == 1)) { d = d + 1; }
        } else {
            if (tc2) { d = d + 1; }
        }
        store8(digits + ndigits, d);
        ndigits = ndigits + 1;
        return;
    }
}

fn ceil_f(x: float): float {
    var t = i2f(f2i(x));
    if (t < x) { return t + 1.0; }
    return t;
}

buffer tb[1300];

/** Java's layout for a number that is not a whole number below 10^15 (and not NaN or infinite). */
fn decimal_text(x: float): int {
    var neg = x < 0.0;
    if (neg) { x = -x; }
    shortest(x);
    if (ndigits == 1) { two_digits(x); }
    var n = 0;
    if (neg) {
        store8(tb, '-');
        n = 1;
    }
    var first = dexp - 1;        // the power of ten of the first digit
    if (x >= 0.001 && x < 10000000.0) {
        if (first >= 0) {
            var i = 0;
            while (i <= first) {
                var dg = 0;
                if (i < ndigits) { dg = load8(digits + i); }
                store8(tb + n, '0' + dg);
                n = n + 1;
                i = i + 1;
            }
            store8(tb + n, '.');
            n = n + 1;
            if (ndigits > first + 1) {
                while (i < ndigits) {
                    store8(tb + n, '0' + load8(digits + i));
                    n = n + 1;
                    i = i + 1;
                }
            } else {
                store8(tb + n, '0');
                n = n + 1;
            }
        } else {
            store8(tb + n, '0');
            store8(tb + n + 1, '.');
            n = n + 2;
            var z = -first - 1;
            while (z > 0) {
                store8(tb + n, '0');
                n = n + 1;
                z = z - 1;
            }
            var j = 0;
            while (j < ndigits) {
                store8(tb + n, '0' + load8(digits + j));
                n = n + 1;
                j = j + 1;
            }
        }
    } else {
        store8(tb + n, '0' + load8(digits));
        store8(tb + n + 1, '.');
        n = n + 2;
        if (ndigits == 1) {
            store8(tb + n, '0');
            n = n + 1;
        }
        var q = 1;
        while (q < ndigits) {
            store8(tb + n, '0' + load8(digits + q));
            n = n + 1;
            q = q + 1;
        }
        store8(tb + n, 'E');
        n = n + 1;
        var es = int_text(first);
        copy(tb + n, es + 8, load64(es));
        n = n + load64(es);
    }
    var s = str_new(n);
    copy(s + 8, tb, n);
    return s;
}

buffer cand[8];

/**
 * Java writes at least two digits, and takes the closer two-digit number when it still reads back as x:
 * 4.9E-324 rather than 5.0E-324. The exact value rounded to two digits (half to even), checked by reading it back.
 */
fn two_digits(x: float) {
    var d0 = load8(digits);
    var k = dexp;
    // x / 10^(k-2) as an exact fraction r / s, rounded to a whole number
    scratch_ptr = 0;
    var b = bits(x);
    var be = (b >>> 52) & 0x7FF;
    var f = b & 0xFFFFFFFFFFFFF;
    var e = -1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    var p = k - 2;
    var r = big_new();
    var s = big_new();
    big_set(r, f);
    big_set(s, 1);
    if (e >= 0) { big_shl(r, e); } else { big_shl(s, -e); }
    if (p >= 0) { big_mul_pow10(s, p); } else { big_mul_pow10(r, -p); }
    var t = 0;
    while (big_cmp(r, s) >= 0) {
        big_sub(r, s);
        t = t + 1;
    }
    var twice = big_new();
    big_copy(twice, r);
    big_shl(twice, 1);
    var h = big_cmp(twice, s);
    if (h > 0 || (h == 0 && (t & 1) == 1)) { t = t + 1; }
    if (t < 10 || t > 99) { return; }       // the value sits at a power of ten: one digit is all there is
    // does t * 10^p read back as x?
    store8(cand, t / 10);
    store8(cand + 1, t % 10);
    var y = parse_digits(cand, 2, p);
    if (bits(y) != bits(x)) { return; }
    store8(digits, t / 10);
    store8(digits + 1, t % 10);
    ndigits = 2;
    dexp = p + 2;
    if (t % 10 == 0) { ndigits = 1; }
}

/** A number as the interpreter writes it: whole numbers below 10^15 without ".0", others like Java. */
fn num_text(x: float): int {
    if (x != x) { return "NaN"; }
    if (x == 1.0 / 0.0) { return "Infinity"; }
    if (x == -1.0 / 0.0) { return "-Infinity"; }
    if (x > -1000000000000000.0 && x < 1000000000000000.0) {
        var w = f2i(x);
        if (i2f(w) == x) { return int_text(w); }
    }
    return decimal_text(x);
}

// ================================================================ text to number, exactly as Double.parseDouble

var parse_ok: int;

fn is_space(c): int {
    return c >= 0 && c <= 32;
}

buffer pd[1100];

/** The number in a text, or parse_ok = 0. Decimal numbers, NaN and Infinity (no hexadecimal floats). */
fn parse_text(s): float {
    var n = load64(s);
    var p = s + 8;
    var a = 0;
    var z = n;
    while (a < z && is_space(load8(p + a))) { a = a + 1; }
    while (z > a && is_space(load8(p + z - 1))) { z = z - 1; }
    parse_ok = 0;
    if (a == z) { return 0.0; }
    var neg = 0;
    var c = load8(p + a);
    if (c == '+' || c == '-') {
        neg = c == '-';
        a = a + 1;
    }
    if (z - a == 3 && load8(p + a) == 'N' && load8(p + a + 1) == 'a' && load8(p + a + 2) == 'N') {
        parse_ok = 1;
        return 0.0 / 0.0;
    }
    if (z - a == 8 && word_is(p + a, "Infinity")) {
        parse_ok = 1;
        if (neg) { return -1.0 / 0.0; }
        return 1.0 / 0.0;
    }
    // a type suffix: 1.5f, 2d
    c = load8(p + z - 1);
    if (z - a >= 2 && (c == 'f' || c == 'F' || c == 'd' || c == 'D')) { z = z - 1; }
    var nd = 0;
    var seen = 0;
    var dot = -1;
    var exp10 = 0;
    var sticky = 0;
    var i = a;
    while (i < z) {
        c = load8(p + i);
        if (c >= '0' && c <= '9') {
            seen = 1;
            if (nd == 0 && c == '0') {
                if (dot >= 0) { exp10 = exp10 - 1; }
            } else {
                if (nd < 800) {
                    store8(pd + nd, c - '0');
                    nd = nd + 1;
                    if (dot >= 0) { exp10 = exp10 - 1; }
                } else {
                    if (c != '0') { sticky = 1; }
                    if (dot < 0) { exp10 = exp10 + 1; }
                }
            }
        } else {
            if (c == '.' && dot < 0) {
                dot = i;
            } else {
                break;
            }
        }
        i = i + 1;
    }
    if (!seen) { return 0.0; }
    if (i < z) {
        c = load8(p + i);
        if (c != 'e' && c != 'E') { return 0.0; }
        i = i + 1;
        var eneg = 0;
        if (i < z && (load8(p + i) == '+' || load8(p + i) == '-')) {
            eneg = load8(p + i) == '-';
            i = i + 1;
        }
        if (i == z) { return 0.0; }
        var ev = 0;
        while (i < z) {
            c = load8(p + i);
            if (c < '0' || c > '9') { return 0.0; }
            if (ev < 100000000) { ev = ev * 10 + (c - '0'); }
            i = i + 1;
        }
        if (eneg) { ev = -ev; }
        exp10 = exp10 + ev;
    }
    parse_ok = 1;
    if (sticky) {
        store8(pd + nd, 1);
        nd = nd + 1;
        exp10 = exp10 - 1;
    }
    var v = parse_digits(pd, nd, exp10);
    if (neg) { return -v; }
    return v;
}

fn word_is(p, w): int {
    var n = load64(w);
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(w + 8 + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

/** 10^k as a double, close (a few ulps): only a first guess for parse_digits. */
fn pow10_guess(k): float {
    var r = 1.0;
    var b = 10.0;
    var neg = k < 0;
    if (neg) { k = -k; }
    while (k > 0) {
        if (k & 1) { r = r * b; }
        b = b * b;
        k = k >> 1;
    }
    if (neg) { return 1.0 / r; }
    return r;
}

var cmp_d: int;     // the digits as a big number, made once per parse

/** The double nearest to the whole number d1d2...dn (digit values, not characters) * 10^e, half to even. */
fn parse_digits(dp, n, e): float {
    var i = 0;
    while (i < n && load8(dp + i) == 0) { i = i + 1; }
    if (i == n) { return 0.0; }
    if (n + e > 310) { return 1.0 / 0.0; }
    if (n + e < -330) { return 0.0; }
    scratch_ptr = 0;
    cmp_d = big_new();
    var j = 0;
    while (j < n) {
        big_mul_small(cmp_d, 10);
        big_add_small(cmp_d, load8(dp + j));
        j = j + 1;
    }
    // a first guess from at most 18 digits
    var m0 = 0;
    var used = 0;
    while (used < n && used < 18) {
        m0 = m0 * 10 + load8(dp + used);
        used = used + 1;
    }
    var e0 = e + (n - used);
    var x = i2f(m0);
    if (e0 > 300) {
        x = x * pow10_guess(300) * pow10_guess(e0 - 300);
    } else {
        if (e0 < -300) {
            x = x * pow10_guess(-300) * pow10_guess(e0 + 300);
        } else {
            x = x * pow10_guess(e0);
        }
    }
    var inf = 1.0 / 0.0;
    if (x == inf) { x = fbits(0x7FEFFFFFFFFFFFFF); }
    var mark = scratch_ptr;
    var rounds = 0;
    while (rounds < 2000) {
        rounds = rounds + 1;
        scratch_ptr = mark;
        var xb = bits(x);
        var be = (xb >>> 52) & 0x7FF;
        var m = xb & 0xFFFFFFFFFFFFF;
        var k = -1074;
        if (be != 0) {
            m = m | 0x10000000000000;
            k = be - 1075;
        }
        // above the midpoint with the next double up?
        var c = cmp_scaled(e, 2 * m + 1, k - 1);
        if (c > 0 || (c == 0 && (m & 1) == 1)) {
            x = fbits(xb + 1);
            if (x == inf) { return inf; }
            continue;
        }
        if (xb == 0) { return 0.0; }
        // below the midpoint with the next double down?
        var lm = 2 * m - 1;
        var lk = k - 1;
        if (m == 0x10000000000000 && be > 1) {
            lm = 4 * m - 1;
            lk = k - 2;
        }
        c = cmp_scaled(e, lm, lk);
        if (c < 0 || (c == 0 && (m & 1) == 1)) {
            x = fbits(xb - 1);
            continue;
        }
        return x;
    }
    return x;
}

/** Compares cmp_d * 10^e with mid * 2^k, exactly. */
fn cmp_scaled(e, mid, k): int {
    var a = big_new();
    var b = big_new();
    big_copy(a, cmp_d);
    big_set(b, mid);
    if (e >= 0) { big_mul_pow10(a, e); } else { big_mul_pow10(b, -e); }
    if (k >= 0) { big_shl(b, k); } else { big_shl(a, -k); }
    return big_cmp(a, b);
}
